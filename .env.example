# Forms backend. Both site forms submit to HubSpot forms in portal 343684856
# ("Yanchan Produced"). NOTE this is a DIFFERENT portal from the 6DC one the
# workspace HubSpot connector is authenticated to — do not cross them.
#
# No secret here: the submission endpoint needs no authentication, so these are
# ids, not credentials. With them unset both routes return 503 with an honest
# message rather than accepting and discarding a submission. That is also the
# rollback: unset and redeploy.
#
# HAZARD: the endpoint answers 200 for a field the form does not have and
# stores nothing. If someone deletes the Message or Inquiry type field in
# HubSpot, booking enquiries keep "succeeding" while losing their contents, and
# no log anywhere will say so. Verify by reading a contact, never a status code.
HUBSPOT_PORTAL_ID=
HUBSPOT_BOOKING_FORM_GUID=
HUBSPOT_NEWSLETTER_FORM_GUID=

# PUBLIC twin of HUBSPOT_PORTAL_ID, same value. Turns on HubSpot's tracking
# script, which loads only after the visitor accepts the consent banner and
# sets the `hubspotutk` cookie. The form routes read that cookie and pass it as
# `context.hutk`, which is what joins an enquiry to the pages the visitor read.
#
# The two names are kept separate on purpose: the server routes must carry on
# reading a server variable, so a change to how public config is handled cannot
# silently break form delivery.
#
# Adding or removing this CHANGES WHAT THE CONSENT BANNER MUST SAY. A product
# that loads without being named in the banner makes the disclosure untrue.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# Phase 2. Tour merch checkout (Square). /api/checkout + /api/square/webhook.
#
# NAMES ONLY. Never put a value in this file or in any .env in the repo.
# Every Square credential lives in the macOS keychain, per the workspace rule
# that credentials never live in files. Sandbox and production are different
# tokens against different data; build and prove the flow on sandbox first,
# because the first real transaction is Yanchan's money.
#
# The store renders with NONE of these set: every SKU reads as in stock, the
# order list is empty, and checkout answers "not live yet" instead of failing.
#
# Access token for the account taking the money. Server-side only, never
# NEXT_PUBLIC_. It reads the catalogue, creates orders and payment links, reads
# and moves inventory, and advances fulfilment.
SQUARE_ACCESS_TOKEN=

# Which location the orders and the inventory belong to. Sandbox is
# LRK7XC5E1F11G, country CA, currency CAD.
SQUARE_LOCATION_ID=

# Signing key for the `/api/square/webhook` endpoint. Without it the endpoint
# safely acknowledges and ignores events so Square does not retry forever.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Exact production webhook URL registered in Square, including path. Square
# signs this string with the raw request body, so aliases must not be guessed.
SQUARE_WEBHOOK_NOTIFICATION_URL=

# `sandbox` or `production`. Picks which Square API host the client talks to.
# Unset is treated as sandbox, so production is never reached by accident.
SQUARE_ENVIRONMENT=

# PUBLIC, baked into the client bundle at build time. Square's Web Payments
# SDK needs them to tokenize cards / Apple Pay / Google Pay in the browser.
# They identify the app, they do not grant access: charges still happen
# server-side with SQUARE_ACCESS_TOKEN.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Internal merch/order console. Leave unset on any public deployment: when it
# is not exactly `1`, `/dashboard/merch` and `/api/merch-admin` return 404.
OPS_DASHBOARD=

# AI-agent connector (MCP). /api/mcp exposes the clipping system to local AI
# agents such as Muse: archive/prepare/select/render streams, review and
# annotate the clip library — the same actions as the dashboard, one shared
# bearer token instead of a click. The endpoint 404s unless OPS_DASHBOARD=1,
# and only exists on this localhost app.
#
# NAMES ONLY here. Generate one, e.g.:  openssl rand -hex 32
# Put the value in the local .env (which is gitignored), and paste the SAME
# value into the agent's connector settings as the bearer token.
#
# Unset means OPEN: any local process can call the tools. Fine on a
# single-operator Mac, wrong on any shared machine.
YP_MCP_TOKEN=

# Phase 3. Members/CMS (choose providers per design.md open questions).
# CLERK_SECRET_KEY=
# SANITY_PROJECT_ID=

# Phase 4. Visitor analytics. Both are PUBLIC ids baked into the client bundle;
# they identify a property, they grant nothing. Neither script is injected until
# the visitor accepts the consent banner — see src/components/consent-provider.
#
# With BOTH unset the site collects nothing and shows no banner, because there
# is nothing to consent to. That is the rollback: unset and redeploy.
#
# Google Analytics 4 measurement id, shaped G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project id, from clarity.microsoft.com. Clarity records
# session replays; it is configured to mask all text input, so nothing a buyer
# types into the checkout is ever captured.
NEXT_PUBLIC_CLARITY_ID=
